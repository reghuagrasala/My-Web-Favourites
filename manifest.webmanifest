{
  "name": "My Safari Favourites",
  "short_name": "Favourites",
  "description": "Personal Safari-style online bookmarks",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#536f8a",
  "theme_color": "#536f8a",
  "icons": [
    {
      "src": "./apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
